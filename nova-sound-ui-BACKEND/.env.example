PORT=4000
NODE_ENV=development

# OPCIÓN 1: Conexión rápida a Neon / Supabase (Recomendada)
DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require

# OPCIÓN 2: Variables individuales (si no usas DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nova_sound

# Frontend URL para CORS
CORS_ORIGIN=http://localhost:5173
